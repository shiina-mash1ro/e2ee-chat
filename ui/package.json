{
  "name": "e2ee-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:extension": "vite build --config vite.extension.config.js",
    "build:all": "npm run build && npm run build:extension",
    "preview": "vite preview --host 127.0.0.1",
    "smoke": "node scripts/smoke-chat.mjs",
    "smoke:extension": "node scripts/smoke-extension.mjs",
    "test:extension": "node --test scripts/test-extension-helpers.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "libsodium-wrappers": "^0.8.4",
    "naive-ui": "^2.43.2",
    "vite": "^7.2.7",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
